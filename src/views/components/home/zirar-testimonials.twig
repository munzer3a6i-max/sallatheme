{#
| Variable                | Type     | Description                       |
|-------------------------|----------|-----------------------------------|
| component.title         | ?string  |                                   |
| component.items[]       | object[] | avatar, name, text, stars         |
| position                | int      | Sorting number start from zero    |
#}
<section component-id="{{ componentId }}"
         data-testid="store-home-custom-testimonials"
         class="s-block s-block--testimonials container overflow-hidden js-reveal">
    <div class="s-reviews-container">
        {% include 'components.partials.section-head' with {
            title: component.title|default(trans('blocks.home.testimonials'))
        } %}

        <salla-slider id="custom-testimonials-{{ position }}-slider"
                      type="testimonials"
                      class="testimonials-slider"
                      centered
                      slides-per-view="1"
                      controls-outer
                      auto-play>
            <div slot="items">
                {% for index, item in component.items %}
                    <div class="s-reviews-swiper-slide swiper-slide">
                        <div class="s-reviews-testimonial">
                            <div class="s-reviews-testimonial__inner">
                                {% if item.avatar %}
                                    <div class="s-reviews-testimonial__avatar">
                                        <img src="{{ item.avatar }}" loading="lazy" width="68" height="68"
                                             alt="{{ item.name|trim ? item.name : 'testimonial-' ~ index }}">
                                    </div>
                                {% endif %}

                                <div class="s-reviews-testimonial__text">
                                    <p>{{ item.text }}</p>
                                    <div class="s-reviews-testimonial__name_wrapper">
                                        <div class="s-reviews-testimonial__info">
                                            <h3 class="text-sm font-bold">{{ item.name }}</h3>
                                        </div>
                                        <salla-rating-stars class="flex" size="small" value="{{ item.stars|default(5) }}"></salla-rating-stars>
                                    </div>
                                </div>

                                <span class="s-reviews-testimonial__icon">
                                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path d="M8 12v-5.333c0-0.737-0.596-1.333-1.333-1.333-3.676 0-6.667 2.991-6.667 6.667v8c0 3.676 2.991 6.667 6.667 6.667h1.333c3.676 0 6.667-2.991 6.667-6.667v-1.333c0-3.676-2.991-6.667-6.667-6.667zM12 20c0 2.205-1.795 4-4 4h-1.333c-2.205 0-4-1.795-4-4v-8c0-1.739 1.115-3.221 2.667-3.772v5.105c0 0.737 0.596 1.333 1.333 1.333h1.333c2.205 0 4 1.795 4 4zM25.333 12v-5.333c0-0.737-0.596-1.333-1.333-1.333-3.676 0-6.667 2.991-6.667 6.667v8c0 3.676 2.991 6.667 6.667 6.667h1.333c3.676 0 6.667-2.991 6.667-6.667v-1.333c0-3.676-2.991-6.667-6.667-6.667zM29.333 20c0 2.205-1.795 4-4 4h-1.333c-2.205 0-4-1.795-4-4v-8c0-1.739 1.115-3.221 2.667-3.772v5.105c0 0.737 0.596 1.333 1.333 1.333h1.333c2.205 0 4 1.795 4 4z"></path>
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </salla-slider>
    </div>
</section>
