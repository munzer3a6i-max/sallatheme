{#
| Variable           | Type    | Description                                  |
|--------------------|---------|----------------------------------------------|
| component.title    | ?string |                                              |
| component.brands   | Brand[] | selected brands: name, url, logo             |
| component.show_all | bool    | show a link to the brands index              |
| position           | int     | Sorting number start from zero               |
#}
<section component-id="{{ componentId }}"
         data-testid="store-home-brands"
         class="s-block s-block--logos-slider s-block--full-bg js-reveal">
    <div class="container">
        {% if component.title or component.show_all %}
            <div class="s-block__title">
                {% if component.title %}
                    <div class="right-side"><h2>{{ component.title }}</h2></div>
                {% endif %}
                {% if component.show_all and theme.settings.get('is_more_button_enabled', true) %}
                    <a href="{{ link('brands') }}" class="s-block__display-all">
                        {{ trans('blocks.home.display_all') }} <i class="sicon-arrow-left {{ theme.is_rtl ? '' : 'flip-x' }}"></i>
                    </a>
                {% endif %}
            </div>
        {% endif %}

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6">
            {% for brand in component.brands %}
                <a href="{{ brand.url }}" class="brand-item">
                    <img src="{{ brand.logo }}" alt="{{ brand.name }}" loading="lazy" width="300" height="120">
                </a>
            {% endfor %}
        </div>
    </div>
</section>
