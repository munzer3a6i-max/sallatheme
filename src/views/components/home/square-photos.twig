{#
| Variable          | Type   | Description                                      |
|-------------------|--------|--------------------------------------------------|
| title             | string | Section title                                    |
| items[]           | array  | List of images                                   |
| items[].url       | string |                                                  |
| items[].link_type | string | category,product,offers,page,external_link,brand |
| items[].image.url | string |                                                  |
| items[].image.alt | string |                                                  |
| items[].text      | string | Visible title over the photo                     |
| position          | Int    | Sorting number start from zero                   |
#}
{% set photos_count = items|length %}
{% set equal_size = theme.settings.get('square_photos_equal_size', false) %}
{% set cols = photos_count in [2, 4] ? 'md:grid-cols-2' : (photos_count > 1 ? 'md:grid-cols-3' : 'md:grid-cols-1') %}
<section component-id="{{ componentId }}" data-testid="store-home-square-photos"
         class="s-block s-block--banners container js-reveal">
    {% include 'components.partials.section-head' with { title: title } %}

    <div class="grid grid-flow-row gap-3 sm:gap-6 {{ cols }}">
        {% for item in items %}
            <a class="banner-entry square-photos {{ item.text ? 'has-overlay' : '' }} {{ equal_size ? 'h-banner' : '' }}"
               href="{{ item.url }}"
               {% if item.link_type == 'external_link' %}target="_blank" rel="noopener"{% endif %}
               aria-label="{{ item.text|default(item.image.alt)|default('banner') }}">
                <div class="lazy__bg lazy absolute inset-0" data-bg="{{ item.image.url }}"
                     style="background-image:url('{{ item.image.url }}');background-size:{{ theme.settings.get('squar_photo_bg_image_size', 'cover') }};"></div>
                {% if item.text %}
                    <h3 class="text-with-border"><span>{{ item.text }}</span></h3>
                {% endif %}
            </a>
        {% endfor %}
    </div>
</section>
