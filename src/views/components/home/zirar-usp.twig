{#
| Variable            | Type     | Description                       |
|---------------------|----------|-----------------------------------|
| component.layout    | string   | bar, cards                        |
| component.items[]   | object[] | list of promises                  |
| component.items[].icon  | string | SallaIcons class `sicon-*`       |
| component.items[].title | string |                                   |
| component.items[].text  | string |                                   |
| position            | int      | Sorting number start from zero    |
#}
{% set layout = component.layout|default('cards') %}
<section component-id="{{ componentId }}"
         data-testid="store-home-promises"
         class="s-block s-block--promises layout--{{ layout }} container js-reveal">
    {% set cols = component.items|length > 3 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %}
    <div class="promises-wrap grid grid-cols-1 gap-4 sm:grid-cols-2 {{ cols }} {{ layout == 'bar' ? 'gap-0' : '' }}">
        {% for item in component.items %}
            <div class="promise-item">
                <i class="{{ item.icon|default('sicon-star') }}"></i>
                <div>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
