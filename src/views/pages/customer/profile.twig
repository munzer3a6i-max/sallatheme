{#
| Variable      | Type   | Description                     |
|---------------|--------|---------------------------------|
| user          | object | first_name, last_name, email…   |
| custom_fields | array  | merchant-defined profile fields |
#}
{% extends "layouts.customer" %}

{% block inner_content %}
    {% hook 'customer:profile.form.start' %}

    <form class="form form--user-profile ajax" onsubmit="return salla.form.onSubmit('profile.update', event)">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">

            {% hook 'customer:profile.form.fields.start' %}

            <div class="profile-field-item">
                <label for="first-name" class="mb-2 block text-sm font-bold">{{ trans('pages.profile.first_name') }}</label>
                <input data-testid="store-profile-first-name" type="text" name="first_name" id="first-name"
                       value="{{ user.first_name }}" autocomplete="given-name" required class="form-input">
            </div>

            <div class="profile-field-item">
                <label for="last-name" class="mb-2 block text-sm font-bold">{{ trans('pages.profile.last_name') }}</label>
                <input data-testid="store-profile-last-name" type="text" name="last_name" id="last-name"
                       value="{{ user.last_name }}" autocomplete="family-name" required class="form-input">
            </div>

            <div class="profile-field-item">
                <label for="birthday" class="mb-2 block text-sm font-bold">{{ trans('pages.profile.birthday') }}</label>
                <salla-datetime-picker data-testid="store-profile-birthday"
                                       dateFormat="Y-m-d"
                                       value="{{ user.birthday }}"
                                       placeholder="{{ trans('pages.profile.birthday_placeholder') }}"
                                       required
                                       name="birthday"></salla-datetime-picker>
            </div>

            <div class="profile-field-item">
                <label for="gender" class="mb-2 block text-sm font-bold">{{ trans('pages.profile.gender') }}</label>
                <select data-testid="store-profile-gender" id="gender" class="form-input" name="gender" required>
                    <option placeholder value="">{{ trans('pages.profile.gender_placeholder') }}</option>
                    <option value="male" {{ user.gender == 'male' ? 'selected' : '' }}>{{ trans('pages.profile.male') }}</option>
                    <option value="female" {{ user.gender == 'female' ? 'selected' : '' }}>{{ trans('pages.profile.female') }}</option>
                </select>
            </div>

            <div class="profile-field-item">
                <label for="email" class="mb-2 block text-sm font-bold">{{ trans('common.elements.email') }}</label>
                <input data-testid="store-profile-email" type="email" name="email" id="email"
                       value="{{ user.email }}" class="form-input" required>
            </div>

            <div class="profile-field-item">
                <label for="international-mobile" class="mb-2 block text-sm font-bold">{{ trans('common.elements.mobile') }}</label>
                <salla-tel-input data-testid="store-profile-phone" phone="{{ user.mobile }}"></salla-tel-input>
            </div>

            {% for field in custom_fields %}
                <div class="profile-field-item">
                    <label for="{{ field.id }}" class="mb-2 block text-sm font-bold">{{ field.label }}</label>

                    {% if field.type == 'photo' %}
                        <salla-file-upload instant-upload
                                           value="{{ field.value }}"
                                           url="{{ store.url|trim('/' ~ user.language_code) }}/upload-image"
                                           name="custom_fields[{{ field.id }}]"
                                           payload-name="image"
                                           height="120px">
                            <div class="profile-filepond-placholder">
                                <span class="profile-filepond-placholder-icon"><i class="sicon-camera"></i></span>
                                <p class="profile-filepond-placholder-text">{{ trans('common.uploader.drag_and_drop') }}</p>
                                <span class="filepond--label-action">{{ trans('common.uploader.browse') }}</span>
                            </div>
                        </salla-file-upload>
                        <input type="hidden" name="custom_fields[{{ field.id }}]" value="{{ field.value }}">
                    {% else %}
                        <input type="{{ field.type }}" id="{{ field.id }}" value="{{ field.value }}"
                               name="custom_fields[{{ field.id }}]" class="form-input" {{ field.required ? 'required' : '' }}/>
                    {% endif %}
                </div>
            {% endfor %}

            {% hook 'customer:profile.form.fields.end' %}
        </div>

        {% hook 'customer:profile.form.submit.start' %}

        <salla-button data-testid="store-profile-submit" type="submit" loader-position="end" class="mt-6 w-full">
            {{ trans('common.elements.save') }}
        </salla-button>

        {% hook 'customer:profile.form.submit.end' %}
    </form>

    {% hook 'customer:profile.form.end' %}

    <salla-verify data-testid="store-profile-verify"></salla-verify>

    <salla-user-settings data-testid="store-profile-settings"
                         {{ user.is_notifiable ? 'is-notifiable' : 0 }}
                         class="mt-10 block"></salla-user-settings>
{% endblock %}
