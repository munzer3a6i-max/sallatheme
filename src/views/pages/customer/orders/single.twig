{#
| Variable                      | Type          | Description                                                     |
|-------------------------------|---------------|-----------------------------------------------------------------|
| order.reference_id            | integer       |                                                                 |
| order.created_at              | date          |                                                                 |
| order.status                  | object        | name, icon, color                                               |
| order.packages[]              | array         | shipping_company, branch, items[], status                       |
| order.items[]                 | OrderItem[]   | name, image, price, quantity, total, options, attachments, note |
| order.options                 | OrderOption[] | cart-level options                                              |
| order.links[]                 | array         | url, label, type ['print','shipment','digital']                 |
| order.can_reorder / can_cancel / can_rate | bool  |                                                                 |
| order.is_pending_payment      | bool          |                                                                 |
| order.pending_payment_ends_in | int           | seconds left, zero when already expired                         |
| order.rating                  | ?OrderRatings | store, shipping, product                                        |
#}
{% extends "layouts.customer" %}

{% block inner_title %}
    <div class="mb-3 flex items-center justify-between gap-3">
        <h1 class="flex-1 text-lg font-bold text-start">
            {{ page.title }}
            {% if order.source is same as('buy_as_gift') %}
                <span class="mx-2 inline-block" style="color: var(--color-primary);">
                    <i class="sicon-gift-sharing"></i>&nbsp;{{ trans('pages.orders.gift_tag') }}
                </span>
            {% endif %}
        </h1>
        <salla-edit-order-button data-testid="store-order-edit-btn"></salla-edit-order-button>
    </div>
{% endblock %}

{% block inner_content %}
    <div class="space-y-4">
        {% hook 'customer:orders.single.details.start' %}

        {# ------------------------------------------------------------- summary bar #}
        <div class="s-card flex flex-col md:flex-row">
            <div data-testid="store-order-status" class="single-order-header-item flex-1 px-5 py-4">
                <div class="text-sm" style="color: var(--color-muted);">{{ trans('pages.orders.date') }}</div>
                <b>{{ order.created_at|date|number }}</b>
            </div>

            <div class="single-order-header-item flex flex-1 flex-wrap items-center justify-between gap-3 px-5 py-4 text-sm">
                {% if order.is_pending_payment and order.pending_payment_ends_in == 0 %}
                    <span style="color: var(--color-danger);">{{ trans('pages.orders.pending_payment_expired') }}</span>
                {% else %}
                    <span class="inline-flex items-center gap-1.5" style="color: {{ order.status.color }};">
                        <i class="{{ order.status.icon }}"></i>
                        <span>{{ order.status.name }}</span>
                    </span>
                {% endif %}

                <div class="flex flex-wrap items-center gap-2">
                    {% if order.is_price_quote %}
                        <span style="color: var(--color-danger);">{{ trans('pages.orders.your_order_is_under_review') }}</span>
                    {% endif %}

                    {% for link in order.links %}
                        <a href="{{ link.url }}" target="_blank" rel="noopener" class="btn btn--primary !px-4 !py-2 text-xs">
                            {{ link.label }}
                            <i class="{{ theme.is_rtl ? 'sicon-arrow-up-left' : 'sicon-arrow-up-right' }}"></i>
                        </a>
                    {% endfor %}

                    {% if can_print_invoice %}
                        <salla-button fill="outline" size="small"
                                      onclick="window.open('{{ order.print_url() }}', '_blank', 'toolbar=yes, scrollbars=yes, resizable=yes, width=900, height=700');">
                            <i class="sicon-printer2 v-align"></i>
                            {{ trans('pages.orders.print') }}
                        </salla-button>
                    {% else %}
                        <div class="tooltip-toggle tooltip-toggle--clickable btn btn--outline-light !px-4 !py-2 text-xs">
                            <i class="sicon-printer2 v-align"></i>
                            {{ trans('pages.orders.print') }}
                            <div class="tooltip-content">
                                <small>
                                    {{ trans('pages.orders.to_order_invoice_contact_vendor') }}<br/>
                                    {{ trans('pages.orders.print_order_details') }}
                                    <a class="cursor-pointer underline" style="color: var(--color-primary);"
                                       onclick="window.open('{{ order.print_url() }}', '_blank', 'toolbar=yes, scrollbars=yes, resizable=yes, width=900, height=700');">{{ trans('pages.orders.click_here') }}</a>
                                </small>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if order.is_pickable %}
            <salla-order-branch data-testid="store-order-branch" stack-cards></salla-order-branch>
        {% endif %}

        {% if order.refund_message %}
            <div class="s-card flex items-center gap-2 px-5 py-4">
                <i class="sicon-refund"></i>
                <p class="text-base font-medium">{{ order.refund_message|raw }}</p>
            </div>
        {% endif %}

        {% if store.settings.rating.allow_update and order.rating is not empty %}
            <div class="flex items-start gap-2 rounded p-3 text-sm" style="background-color: var(--color-sand);">
                <i class="sicon-info"></i>
                <p>{{ trans('pages.order.can_edit_or_delete_your_review_within') }} {{ store.settings.rating.update_period }} {{ trans('pages.order.days_since_added') }}.</p>
            </div>
        {% endif %}

        {% if order.can_rate %}
            <div class="rating-header gradient-bg">
                <div>
                    <h2 class="mb-1 font-bold">{{ trans('pages.order.order_rating_title') }}</h2>
                    <p class="text-sm">{{ trans('pages.order.order_rating_message') }}</p>
                </div>
                <salla-button data-testid="store-order-rate-btn" color="light" onclick="salla.event.dispatch('rating::open')">
                    {{ trans('pages.rating.rate') }}
                </salla-button>
            </div>
        {% endif %}

        {# ---------------------------------------------------------------- packages #}
        <div class="space-y-5 overflow-hidden">
            {% for package in order.packages %}
                <div class="shipping-orders">
                    {% if package.shipping_company and not order.is_pickable %}
                        <div class="flex flex-col justify-between gap-3 border-b px-5 py-3 text-sm hairline md:flex-row md:items-center">
                            <div class="flex items-center gap-2">
                                {% if package.shipping_company.logo %}
                                    <img src="{{ package.shipping_company.logo }}" class="max-h-8 max-w-16" alt="{{ package.shipping_company.name }}">
                                {% endif %}
                                <span>{{ package.shipping_company.name }}</span>
                            </div>

                            <div class="flex flex-wrap gap-5">
                                {% if package.branch %}
                                    <span>{{ trans('pages.orders.branch') }}: <span class="font-bold">{{ package.branch.name }}</span></span>
                                {% endif %}

                                {% if package.shipping_company.number %}
                                    <span>{{ trans('pages.orders.shipment_no') }}: <span class="font-bold">{{ package.shipping_company.number|raw }}</span></span>
                                {% endif %}

                                {% if package.is_delivered %}
                                    <span>{{ trans('pages.orders.status') }}:
                                        <span style="color: {{ package.status.color }};">
                                            <i class="center-v {{ package.status.icon }}"></i>{{ package.status.name }}
                                        </span>
                                    </span>
                                {% elseif package.shipping_company.tracing_link %}
                                    <a class="flex items-center gap-1 font-bold hover:opacity-80" style="color: var(--color-primary);"
                                       href="{{ package.shipping_company.tracing_link|raw }}" target="_blank" rel="noopener">
                                        <span class="sicon-shipping"></span>{{ trans('pages.orders.tracking_url') }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {% for item in package.items %}
                        <div data-testid="store-order-item-{{ item.id }}"
                             data-order-item-id="{{ item.id }}"
                             data-order-item-product-id="{{ item.product.id }}"
                             class="order-item border-b p-5 last:border-none">

                            <div class="mb-5 last:mb-0">
                                {% if item.product %}
                                    <div class="mb-4 flex gap-4">
                                        <a href="{{ item.product.url }}" class="shrink-0">
                                            <img src="{{ item.image ?: 'images/placeholder.png' | asset }}" alt="{{ item.name }}"
                                                 class="h-16 w-16 rounded object-{{ item.image ? 'cover' : 'contain' }} sand-bg">
                                        </a>
                                        <div>
                                            <a href="{{ item.product.url }}" class="mb-1.5 block font-semibold leading-5 transition-colors md:text-base">
                                                {{ item.name }}
                                            </a>
                                            <b>{{ item.price|money }}</b>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="flex w-full justify-between py-2.5 text-sm">
                                        <span class="inline-block w-40 font-normal">{{ item.name }}</span>
                                        <b>{{ item.price|money }}</b>
                                    </div>
                                {% endif %}

                                <div class="flex w-full justify-between py-2 text-sm">
                                    <span class="inline-block w-40 font-normal">{{ trans('pages.products.quantity') }}</span>
                                    <b>{{ item.quantity }}</b>
                                </div>
                                <div class="flex justify-between py-2 text-sm">
                                    <span class="inline-block w-40 font-normal">{{ trans('pages.orders.total') }}</span>
                                    <b>{{ item.total|money }}</b>
                                </div>
                            </div>

                            {% if item.availability_date %}
                                <div class="flex gap-2 py-2 text-sm">
                                    <i class="sicon-info"></i>
                                    <span>{{ trans('pages.products.expected_to_be') }}: <b>{{ item.availability_date|date('Y-m-d') }}</b></span>
                                </div>
                            {% endif %}

                            {% if item.product.type == 'booking' and item.product_reservations is not empty %}
                                {% if item.booking_location != null %}
                                    <ul class="text-xs font-medium">
                                        <li class="flex items-baseline justify-between py-1">
                                            <span class="mb-3 mt-5 text-sm font-bold">{{ trans('common.elements.location') }}</span>
                                            <span class="text-unicode">{{ item.booking_location }}</span>
                                        </li>
                                    </ul>
                                {% endif %}

                                <h2 class="mb-3 mt-5 text-sm font-bold">
                                    {{ item.product_reservations.count() > 1 ? trans('pages.cart.reservations') : trans('pages.cart.item_options') }}
                                </h2>

                                <div class="mb-2 rounded border p-4 hairline">
                                    {% include 'pages.partials.product.reservations' with { reservations: item.product_reservations } %}
                                </div>
                            {% endif %}

                            <salla-order-details order-details="{{ item|json_encode }}"></salla-order-details>

                            {% if item.note %}
                                <p class="mt-3 text-sm" style="color: var(--color-muted);">
                                    <span>{{ trans('common.elements.note') }}: </span>{{ item.note }}
                                </p>
                            {% endif %}

                            {% if item.attachments %}
                                <div class="mt-3 flow-root rounded border px-4 hairline">
                                    <dl class="divide-y text-sm hairline">
                                        {% for attachment in item.attachments %}
                                            <div class="items-center justify-between py-3.5 md:flex">
                                                <dt class="mb-2 md:mb-0">{{ trans('pages.products.attachments') }}</dt>
                                                <dd class="font-medium">
                                                    {% if attachment.type == 'image' %}
                                                        <a href="{{ attachment.url }}" target="_blank" rel="noopener">
                                                            <img class="h-8 w-8 rounded object-cover" src="{{ attachment.url }}" alt="{{ item.name }}"/>
                                                        </a>
                                                    {% else %}
                                                        <a href="{{ attachment.url }}" class="text-xs">{{ trans('pages.orders.file_url') }}</a>
                                                    {% endif %}
                                                </dd>
                                            </div>
                                        {% endfor %}
                                    </dl>
                                </div>
                            {% endif %}

                            <salla-review-order-item product-id="{{ item.product.id }}"></salla-review-order-item>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

            {% if order.options|length %}
                <div class="s-card p-5">
                    <h2 class="mb-3 text-sm font-bold">{{ trans('pages.cart.cart_options') }}</h2>
                    <table class="w-full table-fixed border hairline">
                        <thead>
                            <tr class="border-b hairline">
                                <th scope="col" class="p-3 text-start text-sm">{{ trans('pages.order.option_name') }}</th>
                                <th scope="col" class="p-3 text-sm">{{ trans('pages.order.option_content') }}</th>
                                <th scope="col" class="p-3 text-sm rtl:text-left ltr:text-right">{{ trans('pages.products.price') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order.options %}
                                {% for option in item.options %}
                                    <tr class="border-b last:border-b-0 hairline">
                                        <td class="p-3 text-sm">{{ option.name }} :</td>
                                        <td class="p-3 text-center text-xs font-medium">
                                            {% if option.reservations %}
                                                {% include 'pages.partials.product.reservations' with { reservations: option.reservations } %}
                                            {% else %}
                                                {{ option.value }}
                                            {% endif %}
                                        </td>
                                        <td class="p-3 text-xs font-medium rtl:text-start ltr:text-end">
                                            <strong>{{ option.price|money }}</strong>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <salla-order-totals-card data-testid="store-order-totals" order="{{ order }}"></salla-order-totals-card>

        {# ------------------------------------------------------- reorder / cancel #}
        {% if order.can_reorder or order.can_cancel or order.is_pending_payment %}
            <div class="s-card space-y-4 divide-y p-5 hairline">
                {% if order.can_reorder or order.is_pending_payment %}
                    <div class="{{ order.is_pending_payment ? 'flex-center' : 'center-between' }}">
                        {% if order.is_pending_payment %}
                            {% if order.pending_payment_ends_in == 0 %}
                                <span style="color: var(--color-danger);">{{ trans('pages.orders.pending_payment_expired') }}</span>
                            {% else %}
                                <salla-button width="wide" href="{{ order.payment_url }}">
                                    <i class="sicon-wallet rtl:ml-2 ltr:mr-2"></i>
                                    <span>{{ trans('pages.orders.finish_payment') }}</span>
                                </salla-button>
                            {% endif %}
                        {% elseif user.type == 'user' %}
                            <div class="text-sm">
                                <h3 class="mb-1 text-lg font-bold leading-none">{{ trans('pages.orders.reorder') }}</h3>
                                <p style="color: var(--color-muted);">{{ trans('pages.orders.reorder_description') }}</p>
                            </div>
                            <salla-button data-testid="store-order-reorder-btn" shape="link"
                                          onclick="document.querySelector('#reorder-modal').open()">
                                <i class="sicon-rotate rtl:ml-2 ltr:mr-2"></i>
                                <span>{{ trans('pages.orders.reorder') }}</span>
                            </salla-button>
                        {% endif %}
                    </div>
                {% endif %}

                {% if order.can_cancel %}
                    <div class="center-between pt-4">
                        <div class="text-sm">
                            <h3 class="mb-1 text-lg font-bold leading-none">{{ trans('pages.orders.cancel') }}</h3>
                            <p style="color: var(--color-muted);">{{ trans('pages.order.order_cancelation_desc') }}</p>
                        </div>
                        <salla-button data-testid="store-order-cancel-btn" shape="link" color="danger"
                                      onclick="document.querySelector('#modal-order-cancel').open()">
                            <i class="sicon-cancel-circle rtl:ml-2 ltr:mr-2"></i>
                            <span>{{ trans('pages.orders.cancel') }}</span>
                        </salla-button>
                    </div>
                {% endif %}
            </div>

            {% if user.type == 'user' and order.can_reorder %}
                <salla-modal width="sm" id="reorder-modal" icon="sicon-rotate" icon-style="success"
                             modal-title="{{ trans('pages.orders.reorder') }}"
                             sub-title="{{ trans('pages.orders.reorder_confirmation')|raw }}">
                    <div slot="footer" class="grid grid-cols-2 gap-3">
                        <salla-button id="btn-reorder" width="wide">{{ trans('common.elements.ok') }}</salla-button>
                        <salla-button class="w-full" fill="outline" color="light"
                                      onclick="document.querySelector('#reorder-modal').close()">{{ trans('common.elements.cancel') }}</salla-button>
                    </div>
                </salla-modal>
            {% endif %}

            {% if order.can_cancel %}
                <salla-modal width="sm" id="modal-order-cancel" icon="sicon-cancel" icon-style="error"
                             modal-title="{{ trans('common.elements.warning') }}"
                             sub-title="{{ trans('pages.orders.cancel_confirmation') }}">
                    <div slot="footer" class="grid grid-cols-2 gap-3">
                        <salla-button id="confirm-cancel" color="danger" class="w-full cursor-pointer">{{ trans('common.elements.ok') }}</salla-button>
                        <salla-button class="w-full" fill="outline" color="light"
                                      onclick="document.querySelector('#modal-order-cancel').close()">{{ trans('common.elements.cancel') }}</salla-button>
                    </div>
                </salla-modal>
            {% endif %}
        {% endif %}

        {# ------------------------------------------------------------- ratings #}
        {% for rating_type in ['store', 'shipping'] %}
            {% set rating = attribute(order.rating, rating_type) %}
            {% if rating.stars %}
                <section class="s-card flex items-start justify-between p-5">
                    <div>
                        <h2 class="mb-4 text-lg font-bold">
                            {{ rating_type == 'store' ? trans('pages.rating.rate_the_store') : trans('pages.rating.rate_shipping') }}
                        </h2>
                        <p class="mb-2">{{ rating.content|raw }}</p>
                        <salla-rating-stars with-label value="{{ rating.stars }}"></salla-rating-stars>
                    </div>

                    {% if store.settings.rating.allow_update %}
                        <div class="rating-actions">
                            <div class="tooltip-toggle tooltip-toggle--hover">
                                {% if not rating.can_update %}
                                    <div class="tooltip-content"><small>{{ trans('pages.order.edit_period_ended') }}.</small></div>
                                {% endif %}
                                <salla-button loader-position="center" shape="icon" fill="outline" color="dark" size="medium"
                                              {% if not rating.can_update %}disabled{% else %}
                                                  onclick="salla.event.dispatch('rating::edit', {type: '{{ rating_type }}', feedback_id: '{{ rating.id }}' })"
                                              {% endif %}>
                                    <i class="sicon-format-border-color text-xl"></i>
                                </salla-button>
                            </div>

                            <div class="tooltip-toggle tooltip-toggle--hover">
                                {% if not rating.can_update %}
                                    <div class="tooltip-content"><small>{{ trans('pages.order.delete_period_ended') }}.</small></div>
                                {% endif %}
                                <salla-button loader-position="center" shape="icon" fill="outline" color="danger" size="medium"
                                              {% if not rating.can_update %}disabled{% else %}
                                                  onclick="salla.event.dispatch('rating::delete', {feedback_id: '{{ rating.id }}' })"
                                              {% endif %}>
                                    <i class="sicon-trash-2 text-xl"></i>
                                </salla-button>
                            </div>
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        {% endfor %}

        {% hook 'customer:orders.single.details.end' %}

        {% if order.can_rate or store.settings.rating.allow_update %}
            <salla-rating-modal data-testid="store-order-rating-modal"></salla-rating-modal>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'order.js' | asset }}"></script>
{% endblock %}
