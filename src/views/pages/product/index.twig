{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "product.index"                                                  |
| category                   | ?Category   | name, url, image, sub_categories                                     |
| filters                    | bool        | are filters allowed on this page                                     |
| sort_options[]             | SortList[]  | id, name, is_selected                                                |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}

{% block content %}
    {% if theme.settings.get('product_index_show_breadcrumbs', true) %}
        <div class="container container--breadcrumbs">
            <nav class="breadcrumbs w-full py-5">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        </div>
    {% endif %}

    <div class="s-blocks-wrapper s-before-products-list">{% hook 'product.index.before_products_group_with_filter' %}</div>

    {# Category hero — gives listing pages the same editorial feel as the home page. #}
    {% if category and category.image %}
        <div class="container">
            <div class="relative mb-6 overflow-hidden rounded lg:mb-10">
                <img src="{{ category.image }}" alt="{{ category.name }}" loading="eager"
                     class="h-40 w-full object-cover sm:h-56 lg:h-72">
                <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-6">
                    <h1 class="text-xl font-bold text-white sm:text-3xl">{{ category.name }}</h1>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="container container--products-list flex flex-col items-start md:flex-row">
        {% if filters %}
            <button class="btn--close-sm close-filters sicon-cancel hidden"></button>
            <salla-filters data-testid="store-products-filters" class="flex-none md:w-72 lg:sticky lg:top-24" id="filters-menu"></salla-filters>
        {% endif %}

        <div class="main-content w-full flex-1 {{ filters ? 'rtl:lg:mr-8 ltr:lg:ml-8' : '' }}">
            <div class="products-toolbar">
                <h1 class="text-xl font-bold" id="page-main-title">{{ page.title|raw }}</h1>

                <div class="flex items-center gap-2">
                    {% if filters %}
                        <a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" class="filters-trigger lg:hidden"
                           aria-label="{{ trans('blocks.zirar.filters') }}">
                            <i class="sicon-filter text-lg"></i>
                        </a>
                    {% endif %}

                    {% if sort_options|length %}
                        <div class="flex items-center gap-2">
                            <label class="hidden whitespace-nowrap sm:block" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
                            <select id="product-filter" class="form-input">
                                {% for sort in sort_options %}
                                    <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% hook 'product:index.items.start' %}

            {# Nothing is marked selected when the store default sort is disabled,
               so the shown option is sent with the first request. #}
            {% set sort_list = sort_options|default([]) %}
            {% set first_sort = sort_list|first %}
            {% set has_selected_sort = sort_list|filter(sort => sort.is_selected)|length %}
            {% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

            <div class="flex">
                <salla-products-list data-testid="store-products-list"
                                     class="min-w-0 flex-1"
                                     source="{{ page.slug }}"
                                     source-value="{{ page.id }}"
                                     sort-by="{{ fallback_sort }}"
                                     {{ filters ? 'filters-Results' : '' }}></salla-products-list>
            </div>

            {% hook 'product:index.items.end' %}
        </div>
    </div>

    <div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

    {% if store.settings.category.testimonial_enabled %}
        {% component 'home.testimonials' %}
    {% endif %}

    <div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
