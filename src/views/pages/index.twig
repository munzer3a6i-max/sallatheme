{#
| Variable   | Type   | Description  |
|------------|--------|--------------|
| page       | object |              |
| page.title | string | *could be html|
| page.slug  | string | ex: "index"  |

  The home page is composed by the merchant from the theme's components
  (twilight.json → `components`) plus the Salla built-in blocks; `{% component home %}`
  renders them in the order chosen in the dashboard.
#}
{% extends "layouts.master" %}

{% block content %}
    {% component home %}
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
