{#
| Variable            | Type         | Description |
|---------------------|--------------|-------------|
| article.title       | string       |             |
| article.body        | string *HTML |             |
| article.has_image   | Bool         |             |
| article.image       | object       | url, alt    |
| article.created_at  | ?Date        |             |
| article.author      | object       | name, url   |
| related             | Article[]    |             |
| article.tags        | BlogTag[]    | name, url   |
#}
{% extends "layouts.master" %}

{% block content %}
    <div class="container mb-10 sm:mb-20">
        <nav class="breadcrumbs center-between w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>

        <div class="items-start md:flex">
            <div class="main-content blog-category s-card mb-10 flex-1 p-6 md:mb-0 md:w-96 lg:p-10">
                <h1 class="mb-4 text-2xl font-bold leading-10 sm:text-3xl">{{ article.title }}</h1>

                <div class="mb-8 inline-flex gap-5 text-sm" style="color: var(--color-muted);">
                    <span class="flex items-center gap-1"><i class="sicon-calendar-date"></i>{{ article.created_at|date }}</span>
                    <a href="{{ article.author.url }}" class="flex items-center gap-1"><i class="sicon-user"></i>{{ article.author.name }}</a>
                </div>

                {% if article.has_image %}
                    <img src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}"
                         title="{{ article.image.alt }}" class="mb-8 h-80 w-full rounded object-cover"/>
                {% endif %}

                {% if store.settings.blog.allow_likes_and_comments %}
                    <div class="mb-3 flex items-center gap-3 text-base" style="color: var(--color-muted);">
                        <button id="blog-like" data-blog-id="{{ article.key }}" class="flex items-center gap-1">
                            <i class="sicon-thumbs-up" style="color: var(--color-primary);"></i>
                            <span>{{ article.likes_count }}</span>
                        </button>
                        {% if article.comments_count %}
                            <span class="flex items-center gap-1">
                                <i class="sicon-chat" style="color: var(--color-primary);"></i>{{ article.comments_count }}
                            </span>
                        {% endif %}
                    </div>
                {% endif %}

                <article class="content-entry mb-10 leading-8">{{ article.body|replace({'&nbsp;': ' '})|raw }}</article>

                {% if article.tags|length %}
                    <div class="flex flex-wrap items-center gap-2 border-t p-4 hairline">
                        {% for tag in article.tags %}
                            <a href="{{ tag.url }}" class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-sm sand-bg">
                                <i class="sicon-tag"></i><span class="fix-align whitespace-nowrap">{{ tag.name }}</span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if store.settings.blog.allow_likes_and_comments %}
                    <salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>
                {% endif %}
            </div>

            <aside aria-label="Sidebar" class="sticky top-24 shrink-0 pb-11 md:w-96 rtl:lg:mr-8 ltr:lg:ml-8">
                {% if related|length %}
                    <h2 class="mb-3 font-bold">{{ trans('pages.blog_articles.related') }}</h2>

                    {% hook 'blog:single.items.start' %}

                    {% for article in related %}
                        <div class="s-card mt-4 flex items-center gap-3 p-4">
                            <a href="{{ article.url }}" class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded sand-bg">
                                <span class="sr-only">{{ article.title }}</span>
                                {% if article.has_image %}
                                    <img class="h-full w-full object-cover" src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}" loading="lazy">
                                {% else %}
                                    <img class="w-10 object-contain opacity-60" src="{{ 'images/placeholder.png' | asset }}" alt="{{ article.title }}" loading="lazy"/>
                                {% endif %}
                            </a>
                            <div>
                                <div class="mb-1 flex items-center gap-1 text-sm" style="color: var(--color-muted);">
                                    <i class="sicon-calendar-date"></i><time>{{ article.created_at|date }}</time>
                                </div>
                                <h3 class="text-sm font-bold leading-6">
                                    <a href="{{ article.url }}" class="hover:underline">{{ article.title }}</a>
                                </h3>
                            </div>
                        </div>
                    {% endfor %}

                    {% hook 'blog:single.items.end' %}
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
