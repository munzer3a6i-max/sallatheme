{#
| Variable          | Type    | Description                                               |
|-------------------|---------|-----------------------------------------------------------|
| brand.name        | string  |                                                           |
| brand.logo        | string  |                                                           |
| brand.banner      | ?string | Null when not set, or the merchant hides it               |
| brand.description | string  |                                                           |
#}
{% extends "layouts.master" %}

{% block content %}
    {% if brand.banner %}
        <div class="brand-page__banner">
            <img src="{{ brand.banner }}" alt="{{ brand.name }}" width="1200" height="300" loading="eager"
                 class="max-h-[300px] w-full object-cover sand-bg">
        </div>
    {% endif %}

    <div class="container">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>

        {% hook 'brands:single.details.start' %}

        <header class="mb-12 mt-2 flex flex-col items-center text-center md:flex-row md:items-start rtl:md:text-right ltr:md:text-left">
            <img class="h-24 w-40 shrink-0 rounded object-contain p-4 surface shadow-soft" src="{{ brand.logo }}"
                 loading="lazy" alt="{{ brand.name }}">
            <div class="px-5 pt-3">
                <h1 class="mb-1 text-2xl font-bold">{{ brand.name }}</h1>
                <div class="text-base" style="color: var(--color-muted);">{{ brand.description|raw }}</div>
            </div>
        </header>

        {% hook 'brands:single.details.end' %}

        <div class="flex flex-col items-start md:flex-row">
            <div class="main-content w-full">
                {% if products|length %}
                    {% hook 'brands:single.items.start' %}
                    <salla-products-list data-testid="store-brand-products" source="{{ page.slug }}" source-value="{{ page.id }}"></salla-products-list>
                    {% hook 'brands:single.items.end' %}
                {% else %}
                    <div class="no-content-placeholder">
                        <i class="sicon-award-ribbon icon"></i>
                        <p>{{ trans('pages.brands.non_products') }} {{ brand.name }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
